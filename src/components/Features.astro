---
import Icon from './Icon.astro';

const features = [
  { icon: 'camera', title: 'The render behind the camera view', text: 'The delivered image sits behind the camera viewport, fitted to the render frame. Top, side and perspective views stay clean.' },
  { icon: 'refresh', title: 'Follows the scene', text: 'The image is found by the file name of the render output. Activate another setup in Pulze Scene Manager and the picture changes with it.' },
  { icon: 'grid', title: 'Previews of the folder', text: 'Every delivered image as a thumbnail, with a badge of comments still open. A click shows any of them by hand.' },
  { icon: 'pin', title: 'Comments as frames', text: 'Each comment is a frame with a numbered pin, exactly where the client drew it. Pick one in the list and it lights up with its text.' },
  { icon: 'checklist', title: 'A checklist', text: 'Click the pin of a card to tick the comment off: its frame goes grey and the badge counts what is left.' },
  { icon: 'eye', title: 'Hide what is in the way', text: 'The eye on a card takes that one frame off the viewport without ticking it off. One button hides them all.' },
  { icon: 'languages', title: 'Translation', text: 'Comments are translated with DeepL and your own API key; the original stays under the translation. Only the text is sent, each comment once.' },
  { icon: 'cloud', title: 'Dropbox and Google Drive', text: 'Dropbox comments come from the file its “Download comments” saves. Google Drive comments are fetched by the link of the folder.' },
  { icon: 'copy', title: 'Copy and open links', text: 'Right-click a card to copy the comment, or to open or copy a web address the client put in it.' },
  { icon: 'folder', title: 'Remembers per scene', text: 'The image folder, the comment source and the Drive link are kept for each scene file. Save As keeps them.' },
  { icon: 'palette', title: 'Your colours', text: 'Text size, frame and text colours and the opacity of the frames are yours to set.' },
  { icon: 'minimize', title: 'Rolls up when not needed', text: 'Collapse the panel into its title bar and it parks at the bottom edge of the 3ds Max window.' },
] as const;
---

<section id="features" class="border-t border-line dark:border-line-dark">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-accent-deep uppercase dark:text-accent">Features</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">The review round, inside 3ds Max</h2>
      <p class="mt-4 text-lg text-ink-muted text-pretty dark:text-ink-muted-dark">
        Corrections usually live in a browser tab, on a screenshot or in a chat. This panel brings them to the
        one place where you act on them.
      </p>
    </div>

    <ul class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <li class="flex gap-4">
          <span class="mt-0.5 grid size-10 shrink-0 place-items-center rounded-xl bg-card text-ink ring-1 ring-line dark:bg-card-dark dark:text-ink-dark dark:ring-line-dark">
            <Icon name={f.icon} size={20} />
          </span>
          <div>
            <h3 class="font-semibold tracking-tight">{f.title}</h3>
            <p class="mt-1.5 text-[15px] leading-relaxed text-ink-muted dark:text-ink-muted-dark">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
