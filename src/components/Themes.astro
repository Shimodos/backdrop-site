---
import Shot from './Shot.astro';
import dark from '../assets/shots/panel-dark.png';
import light from '../assets/shots/panel-light.png';
import viewport from '../assets/shots/viewport.png';

const shots = [
  { src: dark, title: 'Dark', text: 'The default 3ds Max look. The picked comment is highlighted, a ticked one is struck through.', alt: 'Backdrop in the dark theme with previews of the folder and three comments' },
  { src: light, title: 'Light', text: 'Running 3ds Max with the light colour scheme? The panel opens light, with no setting to change.', alt: 'The same panel in the light theme' },
];
---

<section id="themes" class="border-t border-line bg-card dark:border-line-dark dark:bg-card-dark">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-accent-deep uppercase dark:text-accent">Themes</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Looks like it belongs in 3ds Max</h2>
      <p class="mt-4 text-lg text-ink-muted text-pretty dark:text-ink-muted-dark">
        The panel reads the interface colours of 3ds Max and picks its dark or light palette to match;
        the button in its title bar switches between the two whenever you like.
        The frames on the viewport take the colours and the text size you set.
      </p>
    </div>

    <div class="mt-14 grid items-start gap-x-8 gap-y-14 lg:grid-cols-[1fr_1fr_1.6fr]">
      {shots.map((s) => (
        <figure>
          <div class="flex justify-center rounded-2xl bg-paper px-5 py-8 dark:bg-paper-dark">
            <Shot src={s.src} alt={s.alt} width={280} />
          </div>
          <figcaption class="mt-5">
            <span class="font-semibold tracking-tight">{s.title}</span>
            <span class="text-ink-muted dark:text-ink-muted-dark"> · {s.text}</span>
          </figcaption>
        </figure>
      ))}
      <figure>
        <div class="flex justify-center rounded-2xl bg-paper px-5 py-8 dark:bg-paper-dark">
          <Shot src={viewport} alt="Comment frames with numbered pins over a render of a living room" width={520} />
        </div>
        <figcaption class="mt-5">
          <span class="font-semibold tracking-tight">On the viewport</span>
          <span class="text-ink-muted dark:text-ink-muted-dark"> · Frames are drawn by a click-through layer over the camera view, so they never get in the way of selecting and moving things.</span>
        </figcaption>
      </figure>
    </div>

    <p class="mt-10 text-sm text-ink-muted dark:text-ink-muted-dark">
      The renders in the screenshots are the author's own work; the comments on them are made up.
    </p>
  </div>
</section>
