  pin: '<rect x="6" y="9" width="14" height="11" rx="1.500"/><circle cx="6" cy="8" r="3.500" fill="currentColor" stroke="none"/>',
  message: '<path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-8l-5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/>',
